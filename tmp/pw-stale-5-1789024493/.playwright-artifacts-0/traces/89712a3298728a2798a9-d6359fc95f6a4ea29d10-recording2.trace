],["LI",{},"Не задан streaming pool: пики подкачки и вытеснение ресурсов оценены приблизительно."]]],["SECTION",{"class":"card  "},["DIV",{"class":"card-title"},["H2",{"style":"flex: 1 1 0%;"},"Референсная пара CPU + GPU"]],["DIV",{"class":"grid grid-2"},["DIV",{},["H4",{"style":"margin-bottom: 6px;"},"Процессор"],["DIV",{},["DIV",{"style":"display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;"},["STRONG",{},"Core i3-8100"],["SPAN",{"class":"badge badge-info"},"класс ","1"]],["DIV",{"class":"xsmall faint","style":"margin-top: 2px;"},"Intel"," · ","Coffee Lake (8th gen Core)"," · ","Coffee Lake-S"," · ","2017"],["DL",{"class":"kv","style":"margin-top: 8px;"},["DT",{},"Ядра / потоки"],["DD",{},"4"," / ","4"],["DT",{},"Однопоточный индекс"],["DD",{"class":"mono"},"0.47"],["DT",{},"Многопоточный индекс"],["DD",{"class":"mono"},"0.10"],["DT",{},"Поддерживаемая память"],["DD",{},"DDR4-2666"],["DT",{},"TDP"],["DD",{},"65 Вт"]],["P",{"class":"xsmall muted"},"Четырёхъядерный процессор без турбо-буста, пригоден для офисных и мультимедийных систем."],["DIV",{"class":"source-link"},"Источник:"," ",["A",{"href":"https://www.cpubenchmark.net/cpu.php?cpu=Intel+Core+i3-8100&id=3103","target":"_blank","rel":"noreferrer"},"PassMark CPU Benchmarks — Intel Core i3-8100"]]]],["DIV",{},["H4",{"style":"margin-bottom: 6px;"},"Видеокарта"],["DIV",{},["DIV",{"style":"display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;"},["STRONG",{},"GeForce RTX 3060"],["SPAN",{"class":"badge badge-info"},"класс ","3"]],["DIV",{"class":"xsmall faint","style":"margin-top: 2px;"},"NVIDIA"," · ","Ampere"," · ","GA106"," · ","2021"],["DL",{"class":"kv","style":"margin-top: 8px;"},["DT",{},"Память"],["DD",{},"12"," ГБ ","GDDR6"],["DT",{},"Пропускная способность"],["DD",{},"360 ГБ/с"],["DT",{},"Индекс растеризации"],["DD",{"class":"mono"},"0.43"],["DT",{},"Индекс трассировки лучей"],["DD",{"class":"mono"},"0.44"],["DT",{},"TDP"],["DD",{},"170 Вт"]],["DIV",{"class":"chip-row"},["SPAN",{"clas