# Example environment file for the backend.
# Copy to backend/.env and adjust the values.

# Database. If not set, the application uses backend/gamedev_dss.db (SQLite),
# so no DBMS installation is required. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/gamedev_dss

# Echo SQL statements to the console (useful while debugging).
DB_ECHO=false

# Token required in the "x-admin-token" header for the admin section.
ADMIN_TOKEN=admin

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=*

# Fill the knowledge base with the demo MVP dataset on first start.
AUTO_SEED=true
