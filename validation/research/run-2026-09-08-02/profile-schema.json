    "name": {
      "default": "Проект без названия",
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "format": {
      "default": "3D",
      "enum": [
        "2D",
        "2.5D",
        "3D"
      ],
      "title": "Format",
      "type": "string"
    },
    "world_type": {
      "default": "open_world",
      "enum": [
        "linear",
        "hub",
        "arena",
        "open_world",
        "procedural",
        "sandbox"
      ],
      "title": "World Type",
      "type": "string"
    },
    "scale": {
      "default": "large",
      "enum": [
        "small",
        "medium",
        "large",
        "very_large",
        "unknown"
      ],
      "title": "Scale",
      "type": "string"
    },
    "stage": {
      "default": "prototype",
      "enum": [
        "concept",
        "preproduction",
        "prototype",
        "production",
        "alpha",
        "beta",
        "release",
        "post_release"
      ],
      "title": "Stage",
      "type": "string"
