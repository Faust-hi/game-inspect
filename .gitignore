# Виртуальные окружения и зависимости
.venv/
.venv-linux/
venv/
env/
node_modules/

# Сборка frontend
frontend/dist/
frontend/*.tsbuildinfo
*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/

# Базы данных: файлы появляются при запуске и не должны попадать в репозиторий
*.db
*.sqlite
*.sqlite3
backend/gamedev_dss.db
backend/test_gamedev_dss.db
# Сопутствующие файлы SQLite и резервные копии, сделанные перед миграцией
*.db-wal
*.db-shm
*.db.bak*

# Кэши инструментов
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Логи и локальные настройки
*.log
logs/
.env
backend/.env

# Служебные файлы редакторов и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Локальные кэши пакетных менеджеров и рантайма (не переносимы между машинами)
.pnpm-store/
.runtime-packages/

# Локальное состояние агента/инструментов (не является исходниками проекта)
.workbuddy-ai/

# Резервные копии повреждённого .git и прочие форензические бэкапы
.git-safety-backup/
.git-backup*/

# Временные артефакты ручных проверок и рендеров
tmp/

# Исследования: крупные внешние загрузки (первоисточники) и производные кэши.
# Первоисточники воспроизводятся скриптами из tools/, поэтому в git не хранятся.
research/_mp/
research/_verify_cache/

# Резервные копии документов
*.bak.pdf
*.bak.docx
*.bak.pptx

# Архив ценных, но не применяемых в проекте материалов (волна 7).
# Всё вне report/ — рабочий проект. Содержимое report/ остаётся в истории git.
report/
